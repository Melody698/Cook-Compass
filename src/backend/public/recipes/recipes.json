    {
      "id": 2,
      "name": "Beef and Rice Stir Fry",
      "description": "A delicious and savory beef and rice stir fry that is perfect for a quick and easy weeknight meal.",
      "ingredients": [
        "Beef",
        "Onion",
        "Garlic",
        "Rice"
      ],
      "instructions": [
        "Cook the rice according to package instructions.",
        "In a large skillet, heat some oil over medium-high heat.",
        "Add diced onion and minced garlic, sauté until fragrant.",
        "Add thinly sliced beef strips, cook until browned.",
        "Mix in the cooked rice and stir well to combine.",
        "Season with soy sauce, salt, and pepper to taste.",
        "Serve hot and enjoy!"
