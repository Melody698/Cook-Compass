      "id": 4,
      "name": "Beef and Rice Stuffed Cabbage Rolls",
      "description": "Delicious and savory beef and rice mixture rolled in tender cabbage leaves.",
      "ingredients": [
        "Beef",
        "Onion",
        "Garlic",
        "Rice",
        "Cabbage"
      ],
      "instructions": [
        "Boil cabbage leaves until tender. Drain and set aside.",
        "In a skillet, cook beef, onion, and garlic until beef is browned and onions are translucent.",
        "Mix cooked rice into the beef mixture.",
        "Place a spoonful of the beef and rice mixture onto each cabbage leaf and roll.",
        "Arrange the cabbage rolls in a baking dish.",
        "Cover with tomato sauce and bake in the oven until heated through.",
        "Serve hot and enjoy!"
      ],
