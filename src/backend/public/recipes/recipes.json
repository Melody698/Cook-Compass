    {
      "id": 1,
      "name": "Beef and Rice Stuffed Bell Peppers",
      "description": "Delicious and savory bell peppers stuffed with seasoned beef, onion, garlic, and rice.",
      "ingredients": [
        "Beef",
        "Onion",
        "Garlic",
        "Rice",
        "Bell Peppers"
      ],
      "instructions": [
        "Preheat the oven to 375°F (190°C).",
        "Cut the tops off the bell peppers and remove the seeds and membranes.",
        "In a skillet, cook the beef, onion, and garlic until browned. Add cooked rice to the mixture.",
        "Fill each bell pepper with the beef and rice mixture.",
        "Place the stuffed bell peppers in a baking dish and cover with foil.",
        "Bake for 25-30 minutes until the peppers are tender.",
        "Serve hot and enjoy!"
      ],
      "labels": [
        "Dinner",
        "Oven-Baked",
        "Proteins",
